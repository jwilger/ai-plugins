# Legacy project-local package-manager state. No current workflow creates this
# directory, but existing clones may retain npm credentials or Cargo caches
# here until the owner removes it.
/.dependencies/
/**/.dependencies/

# Durable per-project MicroVM state. Contains VM disks, Codex state, and
# project-unique SSH keys; it is data only and must never be committed.
/.codex-vm/
/**/.codex-vm/

# Project-local npm dependencies are restored from package-lock.json.
/node_modules/

# Generated per-machine Codex MCP configuration. The configured binary paths
# are resolved from the local XDG data directory during setup.
/.codex/config.toml

# Rust build artifacts (workspace target dir at repo root).
/target/
/**/target/

# Local Tiber task-board symlink. Canonical task state lives on the `tasks`
# branch and in Git's common directory, not on source branches.
/.tasks

# Browser smoke-test artifacts.
/output/

# cargo-mutants scratch output.
/mutants.out/
/mutants.out.old/

# Generated eval artifacts and static dashboard output. CI uploads/publishes
# these from each run; source configs and fixtures stay tracked.
/.evals/
/evals/out/
/site/evals/*
!/site/evals/.gitkeep

# Generated plugin-eval benchmark runs; benchmark configs may be committed.
/.plugin-eval/runs/
/**/.plugin-eval/runs/
/**/.plugin-eval/benchmark-usage.jsonl

# Side-quest worktrees (default location; configurable via sidequest.toml).
/.worktrees/

# Claude Code native worktree checkouts (runtime artifact; never committed).
/.claude/worktrees/

/.claude/settings.local.json

# Per-worktree runtime environment generated by scripts/worktree-bootstrap.sh.
/.env.worktree

# direnv
.direnv/

# Nix
result
result-*

# Editor / OS noise
.DS_Store
*.swp
.tasks
