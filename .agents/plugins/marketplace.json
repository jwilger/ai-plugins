{
  "name": "ai-plugins",
  "interface": {
    "displayName": "ai-plugins"
  },
  "plugins": [
    {
      "name": "development-system",
      "source": {
        "source": "local",
        "path": "./plugins/development-system"
      },
      "version": "10.0.5",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "tiber",
      "source": {
        "source": "local",
        "path": "./plugins/tiber"
      },
      "version": "1.2.1",
      "category": "Developer Tools",
      "description": "Independent Git-backed task board, CLI, MCP server, and dashboard.",
      "keywords": ["tasks", "git", "coordination"]
    },
    {
      "name": "hyprland-computer-control",
      "source": {
        "source": "local",
        "path": "./plugins/hyprland-computer-control"
      },
      "version": "0.1.4",
      "category": "Developer Tools",
      "description": "Guarded session-local pointer control and screenshots for Hyprland on Wayland.",
      "keywords": ["hyprland", "wayland", "computer-control"]
    }
  ]
}
