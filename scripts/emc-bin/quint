#!/usr/bin/env bash
set -euo pipefail

real_quint="${EMC_REAL_QUINT:?EMC_REAL_QUINT must name the pinned Quint executable}"
arguments=("$@")
invariant_index=-1
temporary_directory=""
trap '[[ -z "$temporary_directory" ]] || rm -rf "$temporary_directory"' EXIT

for ((index = 0; index < ${#arguments[@]}; index++)); do
  if [[ "${arguments[$index]}" == "--invariant" ]]; then
    invariant_index=$((index + 1))
    break
  fi
done

if ((invariant_index < 0 || invariant_index >= ${#arguments[@]})) ||
  [[ "${arguments[$invariant_index]}" != *,* ]]; then
  exec "$real_quint" "${arguments[@]}"
fi

IFS=',' read -r -a invariants <<<"${arguments[$invariant_index]}"
invariants_per_run="${EMC_QUINT_INVARIANTS_PER_RUN:-8}"
if ! [[ "$invariants_per_run" =~ ^[1-9][0-9]*$ ]]; then
  printf 'EMC_QUINT_INVARIANTS_PER_RUN must be a positive integer\n' >&2
  exit 2
fi

# EMC 0.2.0 emits a reachability fold whose fuel equals the complete data-flow
# count. When every flow is already original, the fold is definitionally equal
# to `modelDataFlows`, but Apalache still expands it and can exhaust CI memory.
# In that same case modeled-source resolution and both source-chain invariants
# are tautologies because their predicates short-circuit on `sourceKind`.
# Partially evaluate only that exact case on a disposable verification copy;
# tracked EMC output was checked before this wrapper is invoked.
input_index=$((${#arguments[@]} - 1))
input_path="${arguments[$input_index]}"
if [[ -f "$input_path" ]] && ! grep -q 'sourceKind: ModeledTarget' "$input_path"; then
  temporary_directory="$(mktemp -d "${TMPDIR:-/tmp}/emc-quint.XXXXXX")"
  optimized_input="$temporary_directory/$(basename "$input_path")"
  sed \
    -e 's/^  val modelDataFlowsReachableFromOriginals = .*/  val modelDataFlowsReachableFromOriginals = modelDataFlows/' \
    -e 's/^  val modelDataFlowsReachableFromOriginalsWithPreservedBits = .*/  val modelDataFlowsReachableFromOriginalsWithPreservedBits = modelDataFlows/' \
    -e 's/^  val modelDataFlowModeledSourcesResolve = .*/  val modelDataFlowModeledSourcesResolve = true/' \
    -e 's/^  val modelDataFlowSourceChainsReachOriginals = .*/  val modelDataFlowSourceChainsReachOriginals = true/' \
    -e 's/^  val modelDataFlowSourceChainsPreserveBitEncodingSemantics = .*/  val modelDataFlowSourceChainsPreserveBitEncodingSemantics = true/' \
    "$input_path" >"$optimized_input"
  arguments[$input_index]="$optimized_input"
fi

run_invariants() {
  local invariant_list
  invariant_list="$(IFS=,; printf '%s' "$*")"
  invocation=("${arguments[@]}")
  invocation[$invariant_index]="$invariant_list"
  "$real_quint" "${invocation[@]}"
}

chunk=()
for invariant in "${invariants[@]}"; do
  if [[ "$invariant" == modelDataFlow* ||
    "$invariant" == modelMeaningfulDataFlows* ||
    "$invariant" == modelViewFieldBitEncodings* ||
    "$invariant" == modelExternalPayloadFieldBitEncodings* ||
    "$invariant" == modelDisplayedData* ]]; then
    if ((${#chunk[@]} > 0)); then
      run_invariants "${chunk[@]}"
      chunk=()
    fi
    run_invariants "$invariant"
    continue
  fi
  chunk+=("$invariant")
  if ((${#chunk[@]} == invariants_per_run)); then
    run_invariants "${chunk[@]}"
    chunk=()
  fi
done
if ((${#chunk[@]} > 0)); then
  run_invariants "${chunk[@]}"
fi
