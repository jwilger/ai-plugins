#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: vm-codex status [--json]
       vm-codex runtime [--json]
       vm-codex init [--json]
       vm-codex start [--dry-run] [--json]
       vm-codex stop [--json]
       vm-codex login
       vm-codex remote-control {start|pair|stop}
       vm-shell [--dry-run] [--json]
EOF
}

die() {
  printf 'vm-codex: %s\n' "$1" >&2
  exit 2
}

runtime_command() {
  local output_json=false name path variable
  local -a names=(runner virtiofsd_run bwrap flock python ssh ssh_keygen)
  local -a variables=(CODEX_VM_RUNNER CODEX_VM_VIRTIOFSD_RUN CODEX_VM_BWRAP CODEX_VM_FLOCK CODEX_VM_PYTHON CODEX_VM_SSH CODEX_VM_SSH_KEYGEN)

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) output_json=true ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown runtime argument: $1" ;;
    esac
    shift
  done

  local result='{}' index
  for index in "${!names[@]}"; do
    name="${names[$index]}"
    variable="${variables[$index]}"
    path="${!variable:-}"
    [ -n "$path" ] || die "trusted runtime is missing $name"
    [ -x "$path" ] || die "trusted runtime path is not executable: $path"
    result="$(jq -cn --argjson current "$result" --arg name "$name" --arg path "$path" '$current + {($name): $path}')"
  done

  if [ "$output_json" = true ]; then
    jq -cn --argjson schema_version 1 --argjson tools "$result" '{schema_version: $schema_version, tools: $tools, host_nix_evaluation: false}'
  else
    printf 'Trusted Codex VM runtime is installed.\n'
  fi
}

initialize_state() {
  local ssh_dir="$STATE_DIR/ssh" key_share="$STATE_DIR/ssh-keys" bootstrap_dir="$STATE_DIR/bootstrap"
  local extra_share_dir="$STATE_DIR/extra-shares"
  local path temp temp_dir

  for path in \
    "$STATE_DIR" \
    "$ssh_dir" \
    "$key_share" \
    "$bootstrap_dir" \
    "$extra_share_dir" \
    "$extra_share_dir/ro-0" \
    "$extra_share_dir/ro-1" \
    "$extra_share_dir/ro-2" \
    "$extra_share_dir/ro-3" \
    "$extra_share_dir/rw-0" \
    "$extra_share_dir/rw-1" \
    "$extra_share_dir/rw-2" \
    "$extra_share_dir/rw-3"; do
    [ ! -L "$path" ] || die "VM state directories must not be symlinks: $path"
    [ ! -e "$path" ] || [ -d "$path" ] || die "VM state path must be a directory: $path"
  done

  umask 077
  mkdir -p \
    "$ssh_dir" \
    "$key_share" \
    "$bootstrap_dir" \
    "$extra_share_dir"/{ro-0,ro-1,ro-2,ro-3,rw-0,rw-1,rw-2,rw-3}
  chmod 700 "$STATE_DIR" "$ssh_dir" "$bootstrap_dir" "$extra_share_dir" "$extra_share_dir"/*
  chmod 755 "$key_share"
  temp_dir="$(mktemp -d "$STATE_DIR/.init.XXXXXX")"
  trap 'rm -rf -- "$temp_dir"' EXIT

  for path in \
    "$ssh_dir/client_ed25519" \
    "$ssh_dir/client_ed25519.pub" \
    "$ssh_dir/known_hosts" \
    "$key_share/codex.pub" \
    "$key_share/ssh_host_ed25519_key" \
    "$key_share/ssh_host_ed25519_key.pub" \
    "$bootstrap_dir/preferences.toml" \
    "$bootstrap_dir/shares.json"; do
    [ ! -L "$path" ] || die "VM state files must not be symlinks: $path"
    if [ -e "$path" ]; then
      [ -f "$path" ] || die "VM state path must be a regular file: $path"
      [ "$(stat -c %h "$path")" -eq 1 ] || die "VM state files must not be hard-linked: $path"
    fi
  done

  if [ ! -e "$ssh_dir/client_ed25519" ]; then
    temp="$temp_dir/client_ed25519"
    "$CODEX_VM_SSH_KEYGEN" -q -t ed25519 -N '' -C "$PROJECT_ID client" -f "$temp"
    mv "$temp" "$ssh_dir/client_ed25519"
    rm -f "$temp.pub"
  fi
  temp="$temp_dir/client_ed25519.pub"
  "$CODEX_VM_SSH_KEYGEN" -y -f "$ssh_dir/client_ed25519" >"$temp"
  mv -f "$temp" "$ssh_dir/client_ed25519.pub"

  if [ ! -e "$key_share/ssh_host_ed25519_key" ]; then
    temp="$temp_dir/ssh_host_ed25519_key"
    "$CODEX_VM_SSH_KEYGEN" -q -t ed25519 -N '' -C "$PROJECT_ID host" -f "$temp"
    mv "$temp" "$key_share/ssh_host_ed25519_key"
    rm -f "$temp.pub"
  fi
  temp="$temp_dir/ssh_host_ed25519_key.pub"
  "$CODEX_VM_SSH_KEYGEN" -y -f "$key_share/ssh_host_ed25519_key" >"$temp"
  mv -f "$temp" "$key_share/ssh_host_ed25519_key.pub"

  temp="$temp_dir/codex.pub"
  cp "$ssh_dir/client_ed25519.pub" "$temp"
  mv -f "$temp" "$key_share/codex.pub"
  chmod 600 "$ssh_dir/client_ed25519" "$key_share/ssh_host_ed25519_key"
  chmod 644 "$ssh_dir/client_ed25519.pub" "$key_share/codex.pub" "$key_share/ssh_host_ed25519_key.pub"
  temp="$temp_dir/known_hosts"
  printf '%s %s\n' "$PROJECT_ID" "$(cat "$key_share/ssh_host_ed25519_key.pub")" >"$temp"
  mv -f "$temp" "$ssh_dir/known_hosts"
  chmod 600 "$ssh_dir/known_hosts"

  if [ ! -e "$bootstrap_dir/preferences.toml" ]; then
    temp="$temp_dir/preferences.toml"
    if ! "$CODEX_VM_PYTHON" - "${HOME:-}/.codex/config.toml" "$temp" <<'PY'
import json
import pathlib
import sys
import tomllib

source = pathlib.Path(sys.argv[1])
destination = pathlib.Path(sys.argv[2])
config = tomllib.loads(source.read_text()) if source.is_file() else {}
allowed = {
    "model": str,
    "model_reasoning_effort": str,
    "model_verbosity": str,
    "personality": str,
    "plan_mode_reasoning_effort": str,
    "web_search": str,
    "file_opener": str,
    "hide_agent_reasoning": bool,
}
lines = ["# Seeded once from an explicit allowlist by vm-codex init."]
for key, expected_type in allowed.items():
    value = config.get(key)
    if type(value) is not expected_type:
        continue
    rendered = "true" if value is True else "false" if value is False else json.dumps(value)
    lines.append(f"{key} = {rendered}")
destination.write_text("\n".join(lines) + "\n")
PY
    then
      die "could not parse the host Codex configuration for preference seeding"
    fi
    chmod 600 "$temp"
    mv "$temp" "$bootstrap_dir/preferences.toml"
  fi
  rm -rf -- "$temp_dir"
  trap - EXIT
}

stage_envrc_inputs() {
  local envrc_dir="$STATE_DIR/bootstrap/envrc"

  "$CODEX_VM_PYTHON" - "$PROJECT_ROOT" "$envrc_dir" <<'PY'
import hashlib
import json
import os
import pathlib
import stat
import sys
import tempfile

project_root = pathlib.Path(sys.argv[1]).resolve(strict=True)
destination = pathlib.Path(sys.argv[2])
for path in (destination, destination / "files"):
    if path.is_symlink():
        raise SystemExit(f"VM envrc state must not be a symlink: {path}")
    if path.exists() and not path.is_dir():
        raise SystemExit(f"VM envrc state must be a directory: {path}")
destination.mkdir(mode=0o700, parents=True, exist_ok=True)
files_dir = destination / "files"
files_dir.mkdir(mode=0o700, exist_ok=True)
os.chmod(destination, 0o700)
os.chmod(files_dir, 0o700)

directories = list(reversed(project_root.parents)) + [project_root]
entries = []
referenced = set()
for directory in directories:
    source = directory / ".envrc"
    try:
        source_stat = source.lstat()
    except FileNotFoundError:
        continue
    if not stat.S_ISREG(source_stat.st_mode) or source_stat.st_nlink != 1:
        raise SystemExit(f"applicable .envrc must be a non-linked regular file: {source}")
    data = source.read_bytes()
    if len(data) > 1024 * 1024:
        raise SystemExit(f"applicable .envrc exceeds the 1 MiB limit: {source}")
    digest = hashlib.sha256(data).hexdigest()
    staged_name = f"{digest}.envrc"
    staged = files_dir / staged_name
    if staged.is_symlink():
        raise SystemExit(f"VM envrc snapshot must not be a symlink: {staged}")
    if staged.exists():
        staged_stat = staged.stat()
        if not stat.S_ISREG(staged_stat.st_mode) or staged_stat.st_nlink != 1:
            raise SystemExit(f"VM envrc snapshot must be an unlinked regular file: {staged}")
        if hashlib.sha256(staged.read_bytes()).hexdigest() != digest:
            raise SystemExit(f"VM envrc snapshot content mismatch: {staged}")
    else:
        fd, temporary_name = tempfile.mkstemp(prefix=".envrc.", dir=files_dir)
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "wb", closefd=True) as handle:
                handle.write(data)
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(temporary_name, staged)
        except BaseException:
            try:
                os.close(fd)
            except OSError:
                pass
            pathlib.Path(temporary_name).unlink(missing_ok=True)
            raise
    os.chmod(staged, 0o600)
    referenced.add(staged_name)
    entries.append({
        "kind": "project" if directory == project_root else "ancestor",
        "path": str(source),
        "relativePath": str(source.relative_to("/")),
        "sha256": digest,
        "staged": staged_name,
    })

manifest = destination / "manifest.json"
if manifest.is_symlink():
    raise SystemExit(f"VM envrc manifest must not be a symlink: {manifest}")
if manifest.exists():
    manifest_stat = manifest.stat()
    if not stat.S_ISREG(manifest_stat.st_mode) or manifest_stat.st_nlink != 1:
        raise SystemExit(f"VM envrc manifest must be an unlinked regular file: {manifest}")
payload = {
    "schemaVersion": 1,
    "projectRoot": str(project_root),
    "projectRelativePath": str(project_root.relative_to("/")),
    "files": entries,
}
fd, temporary_name = tempfile.mkstemp(prefix=".manifest.", dir=destination)
try:
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", closefd=True) as handle:
        json.dump(payload, handle, separators=(",", ":"), sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary_name, manifest)
except BaseException:
    try:
        os.close(fd)
    except OSError:
        pass
    pathlib.Path(temporary_name).unlink(missing_ok=True)
    raise
os.chmod(manifest, 0o600)

for child in files_dir.iterdir():
    if child.name in referenced:
        continue
    child_stat = child.lstat()
    if not stat.S_ISREG(child_stat.st_mode) or child_stat.st_nlink != 1:
        raise SystemExit(f"unexpected linked VM envrc snapshot: {child}")
    child.unlink()
PY
}

init_command() {
  local output_json=false

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) output_json=true ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown init argument: $1" ;;
    esac
    shift
  done

  resolve_project
  runtime_command >/dev/null
  initialize_state
  stage_envrc_inputs

  if [ "$output_json" = true ]; then
    jq -n \
      --argjson schema_version 1 \
      --arg project_id "$PROJECT_ID" \
      --arg state_dir "$STATE_DIR" \
      --arg identity_file "$STATE_DIR/ssh/client_ed25519" \
      --arg known_hosts_file "$STATE_DIR/ssh/known_hosts" \
      '{schema_version: $schema_version, project_id: $project_id, state_dir: $state_dir, identity_file: $identity_file, known_hosts_file: $known_hosts_file}'
  else
    printf 'Initialized Codex VM state at %s.\n' "$STATE_DIR"
  fi
}

resolve_project() {
  local root common_dir common_abs digest name

  root="$(git rev-parse --show-toplevel 2>/dev/null)" ||
    die "run this command from a Git checkout"
  root="$(cd "$root" && pwd -P)"

  common_dir="$(git -C "$root" rev-parse --git-common-dir)"
  case "$common_dir" in
    /*) common_abs="$(cd "$common_dir" && pwd -P)" ;;
    *) common_abs="$(cd "$root/$common_dir" && pwd -P)" ;;
  esac

  digest="$(printf '%s\0%s' "$root" "$common_abs" | sha256sum | cut -c1-16)"
  name="$(basename "$root" | tr -c '[:alnum:]' '-')"
  name="${name#-}"
  name="${name%-}"

  PROJECT_ROOT="$root"
  PROJECT_ID="${name:-project}-$digest"
  STATE_DIR="$root/.codex-vm"
  RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}/ai-plugins-codex-vm/$PROJECT_ID"
}

process_start_time() {
  local pid="$1" stat rest
  local -a fields
  [ -r "/proc/$pid/stat" ] || return 1
  stat="$(cat "/proc/$pid/stat" 2>/dev/null)" || return 1
  rest="${stat##*) }"
  read -r -a fields <<<"$rest"
  [ "${#fields[@]}" -ge 20 ] || return 1
  printf '%s\n' "${fields[19]}"
}

read_pid_record() {
  local record_file="$1" record pid recorded_start current_start
  [ -r "$record_file" ] || return 1
  record="$(cat "$record_file" 2>/dev/null)" || return 1
  read -r pid recorded_start _ <<<"$record"
  [[ "${pid:-}" =~ ^[0-9]+$ ]] || return 1
  [[ "${recorded_start:-}" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  current_start="$(process_start_time "$pid")" || return 1
  [ "$current_start" = "$recorded_start" ] || return 1
  printf '%s\n' "$pid"
}

record_process() {
  local pid="$1" record_file="$2" start
  start="$(process_start_time "$pid")" || return 1
  printf '%s %s\n' "$pid" "$start" >"$record_file"
}

read_ssh_port() {
  local port
  [ -r "$RUNTIME_DIR/ssh.port" ] || return 1
  port="$(cat "$RUNTIME_DIR/ssh.port" 2>/dev/null)" || return 1
  [[ "$port" =~ ^[0-9]+$ ]] || return 1
  [ "$port" -ge 1024 ] && [ "$port" -le 65535 ] || return 1
  printf '%s\n' "$port"
}

ssh_command() {
  local port="$1"
  shift
  "$CODEX_VM_SSH" \
    -F /dev/null \
    -o IdentityAgent=none \
    -o IdentitiesOnly=yes \
    -o PasswordAuthentication=no \
    -o KbdInteractiveAuthentication=no \
    -o StrictHostKeyChecking=yes \
    -o "UserKnownHostsFile=$STATE_DIR/ssh/known_hosts" \
    -o "HostKeyAlias=$PROJECT_ID" \
    -o ConnectTimeout=2 \
    -i "$STATE_DIR/ssh/client_ed25519" \
    -p "$port" \
    codex@127.0.0.1 \
    "$@"
}

wait_for_ssh() {
  local port="$1" attempt
  for ((attempt = 1; attempt <= 120; attempt++)); do
    if ssh_command "$port" -o BatchMode=yes true </dev/null >/dev/null 2>&1; then
      return 0
    fi
    read_pid_record "$RUNTIME_DIR/qemu.pid" >/dev/null || return 1
    sleep 0.5
  done
  return 1
}

refresh_guest_environment() {
  local port="$1"
  if ! ssh_command "$port" -o BatchMode=yes 'sudo systemctl start codex-vm-environment.service'; then
    die "guest project environment refresh failed; inspect codex-vm-environment.service inside the VM"
  fi
}

terminate_recorded_process() {
  local record_file="$1" pid attempt
  pid="$(read_pid_record "$record_file")" || return 0
  kill "$pid" 2>/dev/null || true
  for ((attempt = 1; attempt <= 50; attempt++)); do
    read_pid_record "$record_file" >/dev/null || return 0
    sleep 0.1
  done
  kill -KILL "$pid" 2>/dev/null || true
  for ((attempt = 1; attempt <= 20; attempt++)); do
    read_pid_record "$record_file" >/dev/null || return 0
    sleep 0.1
  done
  return 1
}

allocate_ssh_port() {
  "$CODEX_VM_PYTHON" - <<'PY'
import socket

with socket.socket() as listener:
    listener.bind(("127.0.0.1", 0))
    print(listener.getsockname()[1])
PY
}

assert_safe_directory_path() {
  local path="$1"
  [ ! -L "$path" ] || die "VM runtime directories must not be symlinks: $path"
  [ ! -e "$path" ] || [ -d "$path" ] || die "VM runtime path must be a directory: $path"
}

assert_safe_file_path() {
  local path="$1"
  [ ! -L "$path" ] || die "VM runtime files must not be symlinks: $path"
  if [ -e "$path" ]; then
    [ -f "$path" ] || die "VM runtime path must be a regular file: $path"
    [ "$(stat -c %h "$path")" -eq 1 ] || die "VM runtime files must not be hard-linked: $path"
  fi
}

validate_operational_paths() {
  local path
  for path in "$STATE_DIR/work-export" "$RUNTIME_DIR"; do
    assert_safe_directory_path "$path"
  done
  for path in \
    "$STATE_DIR/launch.lock" \
    "$STATE_DIR/qemu.log" \
    "$STATE_DIR/virtiofsd.log" \
    "$RUNTIME_DIR/qemu.pid" \
    "$RUNTIME_DIR/virtiofsd.pid" \
    "$RUNTIME_DIR/ssh.port" \
    "$RUNTIME_DIR/shares.sha256"; do
    assert_safe_file_path "$path"
  done
}

load_project_config() {
  local config_file="$PROJECT_ROOT/codex-vm.json"
  local authorization_file="${HOME:-}/.config/ai-plugins/codex-vm-shares.json"
  local python="${CODEX_VM_PYTHON:-python3}"

  PROJECT_SHARES='[]'
  [ ! -L "$config_file" ] || die "project configuration must not be a symlink"
  if [ -e "$config_file" ]; then
    [ -f "$config_file" ] || die "project configuration must be a regular file"
    [ "$(stat -c %h "$config_file")" -eq 1 ] || die "project configuration must not be hard-linked"
  fi

  if ! PROJECT_SHARES="$($python - "$config_file" "$authorization_file" "$PROJECT_ID" 2>&1 <<'PY'
import json
import os
import pathlib
import re
import stat
import sys

config_path = pathlib.Path(sys.argv[1])
authorization_path = pathlib.Path(sys.argv[2]) if sys.argv[2] else None
project_id = sys.argv[3]
project_root = config_path.parent.resolve(strict=True)
mount_pattern = re.compile(r"/mnt/[A-Za-z0-9][A-Za-z0-9._-]*\Z")
share_keys = {"source", "mountPoint", "mode"}


def concise_excepthook(_kind, value, _traceback):
    print(value, file=sys.stderr)


sys.excepthook = concise_excepthook


def load_json(path, label):
    try:
        return json.loads(path.read_text())
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise ValueError(f"{label} must be valid JSON: {error}") from error


def exact_object(value, keys, label):
    if not isinstance(value, dict):
        raise ValueError(f"{label} must be a JSON object")
    unknown = sorted(set(value) - keys)
    if unknown:
        raise ValueError(f"unknown {label} field: {unknown[0]}")


if config_path.exists():
    config = load_json(config_path, "project configuration")
else:
    config = {"schemaVersion": 1, "shares": []}
exact_object(config, {"schemaVersion", "shares"}, "configuration")
if type(config.get("schemaVersion")) is not int or config["schemaVersion"] != 1:
    raise ValueError("schemaVersion must be the number 1")
shares = config.get("shares", [])
if not isinstance(shares, list):
    raise ValueError("shares must be an array")

normalized = []
mount_points = set()
mode_counts = {"ro": 0, "rw": 0}
for index, share in enumerate(shares):
    label = f"share {index}"
    exact_object(share, share_keys, label)
    if set(share) != share_keys:
        missing = sorted(share_keys - set(share))
        raise ValueError(f"{label} is missing field: {missing[0]}")
    source_value = share["source"]
    mount_point = share["mountPoint"]
    mode = share["mode"]
    if not isinstance(source_value, str) or not source_value.startswith("/"):
        raise ValueError(f"{label} source must be an absolute path")
    source = pathlib.Path(source_value)
    try:
        canonical = source.resolve(strict=True)
    except OSError as error:
        raise ValueError(f"{label} source must be an existing directory: {source_value}") from error
    if str(canonical) != source_value or not canonical.is_dir() or canonical == pathlib.Path("/"):
        raise ValueError(f"{label} source must be a canonical non-root directory")
    if not isinstance(mount_point, str) or not mount_pattern.fullmatch(mount_point):
        raise ValueError(f"{label} mountPoint must match /mnt/<name>")
    if mount_point in mount_points:
        raise ValueError(f"duplicate share mountPoint: {mount_point}")
    if not isinstance(mode, str) or mode not in mode_counts:
        raise ValueError(f"{label} mode must be ro or rw")
    mode_counts[mode] += 1
    if mode_counts[mode] > 4:
        raise ValueError(f"at most 4 {mode} shares are supported")
    mount_points.add(mount_point)
    normalized.append({"source": source_value, "mount_point": mount_point, "mode": mode})

if normalized:
    if authorization_path is None:
        raise ValueError("extra share is not authorized for this project")
    try:
        authorization_stat = authorization_path.lstat()
    except FileNotFoundError:
        raise ValueError("extra share is not authorized for this project") from None
    if not stat.S_ISREG(authorization_stat.st_mode) or authorization_stat.st_nlink != 1:
        raise ValueError("share authorization must be an unlinked regular file")
    resolved_authorization = authorization_path.resolve(strict=True)
    if resolved_authorization.is_relative_to(project_root):
        raise ValueError("share authorization must be outside the project checkout")
    authorization = load_json(authorization_path, "share authorization")
    exact_object(authorization, {"schemaVersion", "projects"}, "share authorization")
    if type(authorization.get("schemaVersion")) is not int or authorization["schemaVersion"] != 1:
        raise ValueError("share authorization schemaVersion must be the number 1")
    projects = authorization.get("projects")
    if not isinstance(projects, dict):
        raise ValueError("share authorization projects must be an object")
    allowed = projects.get(project_id, [])
    if not isinstance(allowed, list):
        raise ValueError("project share authorization must be an array")
    allowed_tuples = set()
    for index, share in enumerate(allowed):
        label = f"authorized share {index}"
        exact_object(share, share_keys, label)
        if set(share) != share_keys or not all(isinstance(share[key], str) for key in share_keys):
            raise ValueError(f"{label} must contain source, mountPoint, and mode strings")
        allowed_tuples.add((share["source"], share["mountPoint"], share["mode"]))
    for share in normalized:
        requested = (share["source"], share["mount_point"], share["mode"])
        if requested not in allowed_tuples:
            raise ValueError("extra share is not authorized for this project")
        if share["mode"] == "rw" and resolved_authorization.is_relative_to(pathlib.Path(share["source"])):
            raise ValueError("writable share must not contain the owner authorization")

print(json.dumps(normalized, separators=(",", ":"), sort_keys=True))
PY
  )"; then
    die "$PROJECT_SHARES"
  fi
}

build_share_bind_args() {
  local encoded source mode index
  local ro_index=0 rw_index=0
  SHARE_BIND_ARGS=()

  while IFS= read -r encoded; do
    [ -n "$encoded" ] || continue
    source="$({ printf '%s' "$encoded" | base64 --decode | jq -j .source; printf /; })"
    source="${source%/}"
    mode="$(printf '%s' "$encoded" | base64 --decode | jq -r .mode)"
    if [ "$mode" = ro ]; then
      index="$ro_index"
      ro_index=$((ro_index + 1))
      SHARE_BIND_ARGS+=(--ro-bind "$source" "/state/extra-shares/ro-$index")
    else
      index="$rw_index"
      rw_index=$((rw_index + 1))
      SHARE_BIND_ARGS+=(--bind "$source" "/state/extra-shares/rw-$index")
    fi
  done < <(jq -r '.[] | @base64' <<<"$PROJECT_SHARES")
}

stage_share_manifest() {
  local destination="$STATE_DIR/bootstrap/shares.json"

  "$CODEX_VM_PYTHON" - "$PROJECT_SHARES" "$destination" <<'PY'
import json
import os
import pathlib
import sys
import tempfile

shares = json.loads(sys.argv[1])
destination = pathlib.Path(sys.argv[2])
if destination.is_symlink():
    raise SystemExit(f"VM share manifest must not be a symlink: {destination}")
if destination.exists() and (not destination.is_file() or destination.stat().st_nlink != 1):
    raise SystemExit(f"VM share manifest must be an unlinked regular file: {destination}")
counts = {"ro": 0, "rw": 0}
manifest = []
for share in shares:
    mode = share["mode"]
    slot = counts[mode]
    counts[mode] += 1
    manifest.append({"mode": mode, "mountPoint": share["mount_point"], "slot": slot})
payload = {"schemaVersion": 1, "shares": manifest}
fd, temporary_name = tempfile.mkstemp(prefix=".shares.", dir=destination.parent)
try:
    os.fchmod(fd, 0o600)
    with os.fdopen(fd, "w", closefd=True) as handle:
        json.dump(payload, handle, separators=(",", ":"), sort_keys=True)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary_name, destination)
except BaseException:
    try:
        os.close(fd)
    except OSError:
        pass
    pathlib.Path(temporary_name).unlink(missing_ok=True)
    raise
PY
}

compute_share_fingerprint() {
  "$CODEX_VM_PYTHON" - "$PROJECT_SHARES" <<'PY'
import hashlib
import json
import os
import sys

shares = json.loads(sys.argv[1])
identified = []
for share in shares:
    source_stat = os.stat(share["source"], follow_symlinks=False)
    identified.append({
        **share,
        "sourceDevice": source_stat.st_dev,
        "sourceInode": source_stat.st_ino,
    })
payload = json.dumps(identified, separators=(",", ":"), sort_keys=True).encode()
print(hashlib.sha256(payload).hexdigest())
PY
}

status_command() {
  local output_json=false running=false ssh_port_json=null

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) output_json=true ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown status argument: $1" ;;
    esac
    shift
  done

  resolve_project
  if read_pid_record "$RUNTIME_DIR/qemu.pid" >/dev/null; then
    running=true
    if [ -r "$RUNTIME_DIR/ssh.port" ]; then
      local ssh_port
      ssh_port="$(cat "$RUNTIME_DIR/ssh.port" 2>/dev/null)" || ssh_port=""
      [[ "$ssh_port" =~ ^[0-9]+$ ]] && ssh_port_json="$ssh_port"
    fi
  fi

  if [ "$output_json" = true ]; then
    jq -n \
      --argjson schema_version 1 \
      --arg project_id "$PROJECT_ID" \
      --arg project_root "$PROJECT_ROOT" \
      --arg state_dir "$STATE_DIR" \
      --argjson running "$running" \
      --argjson ssh_port "$ssh_port_json" \
      '{schema_version: $schema_version, project_id: $project_id, project_root: $project_root, state_dir: $state_dir, running: $running, ssh_port: $ssh_port}'
  else
    printf '%s: %s\n' "$PROJECT_ID" "$([ "$running" = true ] && printf running || printf stopped)"
  fi
}

start_command() {
  local dry_run=false output_json=false

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=true ;;
      --json) output_json=true ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown start argument: $1" ;;
    esac
    shift
  done

  resolve_project
  load_project_config

  if [ "$dry_run" = true ] && [ "$output_json" = true ]; then
    jq -n \
      --argjson schema_version 1 \
      --arg project_id "$PROJECT_ID" \
      --arg project_root "$PROJECT_ROOT" \
      --arg state_dir "$STATE_DIR" \
      --arg work_source "$PROJECT_ROOT" \
      --argjson extra_shares "$PROJECT_SHARES" \
      '{
        schema_version: $schema_version,
        project_id: $project_id,
        project_root: $project_root,
        state_dir: $state_dir,
        resources: {vcpus: 4, memory_mib: 8192, store_mib: 65536, home_mib: 32768},
        shares: ([{name: "work", source: $work_source, mount_point: "/work", mode: "rw"}] + $extra_shares),
        host_nix_evaluation: false
      }'
  elif [ "$dry_run" = true ]; then
    printf 'Would start %s with %s mounted read/write at /work.\n' "$PROJECT_ID" "$PROJECT_ROOT"
  else
    local ssh_port qemu_pid virtiofsd_pid share_fingerprint running_share_fingerprint
    runtime_command >/dev/null
    initialize_state
    stage_envrc_inputs
    validate_operational_paths
    mkdir -p "$RUNTIME_DIR" "$STATE_DIR/work-export"
    chmod 700 "$RUNTIME_DIR"
    build_share_bind_args
    share_fingerprint="$(compute_share_fingerprint)"
    exec 9>"$STATE_DIR/launch.lock"
    "$CODEX_VM_FLOCK" -x 9

    if qemu_pid="$(read_pid_record "$RUNTIME_DIR/qemu.pid")"; then
      ssh_port="$(read_ssh_port)" || die "running VM has invalid SSH port state; run vm-codex stop before restarting"
      running_share_fingerprint="$(cat "$RUNTIME_DIR/shares.sha256" 2>/dev/null)" ||
        die "running VM has invalid extra-share state; run vm-codex stop before restarting"
      [ "$running_share_fingerprint" = "$share_fingerprint" ] ||
        die "extra shares changed; run vm-codex stop before restarting"
      stage_share_manifest
    else
      if read_pid_record "$RUNTIME_DIR/virtiofsd.pid" >/dev/null; then
        terminate_recorded_process "$RUNTIME_DIR/virtiofsd.pid" ||
          die "surviving virtiofsd did not stop during VM recovery"
      fi
      rm -f "$RUNTIME_DIR/qemu.pid" "$RUNTIME_DIR/virtiofsd.pid" "$RUNTIME_DIR/ssh.port" "$RUNTIME_DIR/shares.sha256"
      stage_share_manifest
      (
        exec 9>&-
        exec "$CODEX_VM_BWRAP" \
          --die-with-parent \
          --unshare-all \
          --dir /nix \
          --ro-bind /nix/store /nix/store \
          --proc /proc \
          --dev /dev \
          --dir /state \
          --bind "$STATE_DIR" /state \
          --bind "$PROJECT_ROOT" /state/work-export \
          --tmpfs /state/work-export/.codex-vm \
          "${SHARE_BIND_ARGS[@]}" \
          --chdir /state \
          "$CODEX_VM_VIRTIOFSD_RUN"
      ) >"$STATE_DIR/virtiofsd.log" 2>&1 &
      virtiofsd_pid=$!
      record_process "$virtiofsd_pid" "$RUNTIME_DIR/virtiofsd.pid" || die "virtiofsd failed to start"
      sleep 0.2
      if ! read_pid_record "$RUNTIME_DIR/virtiofsd.pid" >/dev/null; then
        rm -f "$RUNTIME_DIR/virtiofsd.pid" "$RUNTIME_DIR/ssh.port"
        die "virtiofsd failed to start; see $STATE_DIR/virtiofsd.log"
      fi

      local attempt started=false
      for ((attempt = 1; attempt <= 5; attempt++)); do
        ssh_port="$(allocate_ssh_port)"
        (
          exec 9>&-
          cd "$STATE_DIR"
          export CODEX_VM_SSH_PORT="$ssh_port"
          exec "$CODEX_VM_RUNNER"
        ) >"$STATE_DIR/qemu.log" 2>&1 &
        qemu_pid=$!
        if record_process "$qemu_pid" "$RUNTIME_DIR/qemu.pid"; then
          sleep 0.2
          if read_pid_record "$RUNTIME_DIR/qemu.pid" >/dev/null; then
            printf '%s\n' "$ssh_port" >"$RUNTIME_DIR/ssh.port"
            printf '%s\n' "$share_fingerprint" >"$RUNTIME_DIR/shares.sha256"
            started=true
            break
          fi
        fi
        wait "$qemu_pid" 2>/dev/null || true
        rm -f "$RUNTIME_DIR/qemu.pid"
      done
      if [ "$started" != true ]; then
        terminate_recorded_process "$RUNTIME_DIR/virtiofsd.pid" || true
        rm -f "$RUNTIME_DIR/virtiofsd.pid" "$RUNTIME_DIR/ssh.port" "$RUNTIME_DIR/shares.sha256"
        die "QEMU failed to claim a loopback SSH port after 5 attempts; see $STATE_DIR/qemu.log"
      fi
    fi

    if ! wait_for_ssh "$ssh_port"; then
      terminate_recorded_process "$RUNTIME_DIR/qemu.pid" || true
      terminate_recorded_process "$RUNTIME_DIR/virtiofsd.pid" || true
      rm -f "$RUNTIME_DIR/qemu.pid" "$RUNTIME_DIR/virtiofsd.pid" "$RUNTIME_DIR/ssh.port" "$RUNTIME_DIR/shares.sha256"
      die "VM did not become reachable over project SSH; see $STATE_DIR/qemu.log"
    fi
    refresh_guest_environment "$ssh_port"

    if [ "$output_json" = true ]; then
      jq -n \
        --argjson schema_version 1 \
        --arg project_id "$PROJECT_ID" \
        --arg state_dir "$STATE_DIR" \
        --argjson pid "$qemu_pid" \
        --argjson ssh_port "$ssh_port" \
        '{schema_version: $schema_version, project_id: $project_id, state_dir: $state_dir, running: true, pid: $pid, ssh_port: $ssh_port, host_nix_evaluation: false}'
    else
      printf 'Started %s (SSH 127.0.0.1:%s).\n' "$PROJECT_ID" "$ssh_port"
    fi
  fi
}

stop_command() {
  local output_json=false stopped=false pid

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) output_json=true ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown stop argument: $1" ;;
    esac
    shift
  done

  resolve_project
  [ ! -L "$STATE_DIR" ] || die "VM state directories must not be symlinks: $STATE_DIR"
  validate_operational_paths
  if [ -d "$STATE_DIR" ]; then
    exec 9>"$STATE_DIR/launch.lock"
    "$CODEX_VM_FLOCK" -x 9
  fi
  for name in qemu virtiofsd; do
    if pid="$(read_pid_record "$RUNTIME_DIR/$name.pid")"; then
      terminate_recorded_process "$RUNTIME_DIR/$name.pid" || die "$name did not stop after SIGKILL"
      stopped=true
    fi
  done
  rm -f "$RUNTIME_DIR/qemu.pid" "$RUNTIME_DIR/virtiofsd.pid" "$RUNTIME_DIR/ssh.port" "$RUNTIME_DIR/shares.sha256"

  if [ "$output_json" = true ]; then
    jq -n --argjson schema_version 1 --arg project_id "$PROJECT_ID" --argjson stopped "$stopped" \
      '{schema_version: $schema_version, project_id: $project_id, running: false, stopped: $stopped}'
  else
    printf '%s: stopped\n' "$PROJECT_ID"
  fi
}

shell_command() {
  local dry_run=false output_json=false

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run) dry_run=true ;;
      --json) output_json=true ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown shell argument: $1" ;;
    esac
    shift
  done

  resolve_project

  if [ "$dry_run" = true ] && [ "$output_json" = true ]; then
    jq -n \
      --argjson schema_version 1 \
      --arg project_id "$PROJECT_ID" \
      --arg project_root "$PROJECT_ROOT" \
      --arg state_dir "$STATE_DIR" \
      '{
        schema_version: $schema_version,
        project_id: $project_id,
        project_root: $project_root,
        state_dir: $state_dir,
        guest_command: ["/bin/bash", "-l"],
        host_nix_evaluation: false
      }'
  elif [ "$dry_run" = true ]; then
    printf 'Would open a login shell in %s at /work.\n' "$PROJECT_ID"
  else
    start_command --json >/dev/null
    resolve_project
    local ssh_port
    ssh_port="$(read_ssh_port)" || die "VM has no valid SSH port state"
    ssh_command "$ssh_port" -tt 'exec codex-vm-enter shell'
  fi
}

codex_command() {
  [ "$#" -eq 0 ] || die "codex takes no arguments"
  start_command --json >/dev/null
  resolve_project
  local ssh_port
  ssh_port="$(read_ssh_port)" || die "VM has no valid SSH port state"
  ssh_command "$ssh_port" -tt 'exec codex-vm-enter codex --yolo'
}

login_command() {
  [ "$#" -eq 0 ] || die "login takes no arguments"
  start_command --json >/dev/null
  resolve_project
  local ssh_port
  ssh_port="$(read_ssh_port)" || die "VM has no valid SSH port state"
  ssh_command "$ssh_port" -tt 'exec codex-vm-enter codex --yolo login --device-auth'
}

remote_control_command() {
  local action="${1:-start}"
  [ "$#" -le 1 ] || die "remote-control accepts one of: start, pair, stop"
  case "$action" in
    start|pair|stop) ;;
    *) die "remote-control accepts one of: start, pair, stop" ;;
  esac
  start_command --json >/dev/null
  resolve_project
  local ssh_port
  ssh_port="$(read_ssh_port)" || die "VM has no valid SSH port state"
  ssh_command "$ssh_port" -tt "exec codex-vm-enter codex --yolo remote-control $action --json"
}

invocation="$(basename "$0")"
if [ "$invocation" = vm-shell ]; then
  command=shell
else
  command="${1:-codex}"
  [ "$#" -eq 0 ] || shift
fi

case "$command" in
  init) init_command "$@" ;;
  codex) codex_command "$@" ;;
  login) login_command "$@" ;;
  remote-control) remote_control_command "$@" ;;
  runtime) runtime_command "$@" ;;
  shell) shell_command "$@" ;;
  status) status_command "$@" ;;
  start) start_command "$@" ;;
  stop) stop_command "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown command: $command" ;;
esac
