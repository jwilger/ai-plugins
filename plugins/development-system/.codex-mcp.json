{
  "mcpServers": {
    "development-discipline": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec \"${CODEX_HOME:-$HOME/.codex}/plugins/cache/ai-plugins/development-system/4.0.0/bin/development-discipline-mcp\" \"$@\"",
        "development-discipline-mcp",
        "--service",
        "plugin-read-only"
      ],
      "description": "Advisory Development System reader and deterministic repository-local setup surface."
    },
    "tiber": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec \"${CODEX_HOME:-$HOME/.codex}/plugins/cache/ai-plugins/development-system/4.0.0/bin/tiber\" \"$@\"",
        "tiber",
        "mcp",
        "stdio"
      ],
      "env": {
        "GIT_SSH_COMMAND": "ssh -F /dev/null"
      },
      "env_vars": ["SSH_AUTH_SOCK"],
      "description": "Git-backed task tracking and bounded backlog coordination."
    }
  }
}
