#!/bin/sh
set -eu

plugin_root="$(cd -- "$(dirname -- "$0")/.." && pwd -P)"
for bash_bin in /run/current-system/sw/bin/bash /bin/bash /usr/bin/bash; do
  if [ -x "$bash_bin" ]; then
    exec "$bash_bin" "$plugin_root/components/development-discipline/bin/development-discipline-mcp" "$@"
  fi
done
echo "development_system.bash_missing component=development-discipline" >&2
exit 127
