#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  printf '%s\n' 'usage: run-beads-hook --project <path> -- <bd arguments...>' >&2
  exit 2
}

config_enables_beads() {
  local config_path=$1
  awk '
    {
      line = $0
      sub(/\r$/, "", line)
      sub(/[[:space:]]*#.*/, "", line)
      if (index(line, "\"\"\"") || index(line, "\047\047\047"))
        multiline_string_delimiter_seen = 1
      if (line ~ /^[[:space:]]*\[features\][[:space:]]*$/) {
        feature_sections++
        in_features = 1
        next
      }
      if (line ~ /^[[:space:]]*\[/) {
        in_features = 0
        next
      }
      if (in_features && line ~ /^[[:space:]]*beads[[:space:]]*=/) {
        beads_assignments++
        if (line ~ /^[[:space:]]*beads[[:space:]]*=[[:space:]]*true[[:space:]]*$/)
          enabled_assignments++
      }
    }
    END {
      exit !(multiline_string_delimiter_seen == 0 && feature_sections == 1 && beads_assignments == 1 && enabled_assignments == 1)
    }
  ' "$config_path" 2>/dev/null
}

[[ "$#" -ge 4 && "$1" == "--project" && "$3" == "--" ]] || usage
project=$2
shift 3

project_root="$(git -C "$project" rev-parse --show-toplevel 2>/dev/null)" || exit 0
config_path="$project_root/.development-system.toml"

[[ -f "$config_path" ]] || exit 0
config_enables_beads "$config_path" || exit 0

cd "$project_root"
exec "$SCRIPT_DIR/bd" "$@"
