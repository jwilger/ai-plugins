#!/usr/bin/env bash
set -euo pipefail

plugin_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
source "$plugin_root/lib/installed-binary.sh"

die() {
  printf '%s\n' "$*" >&2
  exit 2
}

warn() {
  printf 'development_system.warning %s\n' "$*"
}

primary_checkout() {
  local project=$1
  local common_dir
  common_dir="$(git -C "$project" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ||
    die "development_system.not_a_git_repository project=$project"
  dirname "$common_dir"
}

require_primary_checkout() {
  local project=$1
  local git_dir common_dir primary
  if [[ "$(git -C "$project" rev-parse --is-bare-repository 2>/dev/null)" == "true" ]]; then
    die "development_system.setup_requires_checkout project=$project"
  fi
  git_dir="$(git -C "$project" rev-parse --path-format=absolute --git-dir 2>/dev/null)" ||
    die "development_system.not_a_git_repository project=$project"
  common_dir="$(git -C "$project" rev-parse --path-format=absolute --git-common-dir)"
  if [[ "$git_dir" != "$common_dir" ]]; then
    primary="$(primary_checkout "$project")"
    die "development_system.setup_requires_primary_checkout primary_checkout=$primary"
  fi
}

setup_command() {
  local project=.
  local preset=personal-trunk
  local mode=dry-run
  local feature_tiber=true
  local feature_agentic_systems=false
  local feature_eval_case_reporting=false
  while (($#)); do
    case "$1" in
      --project | --preset | --delivery | --enable | --disable)
        local option=$1
        if (($# < 2)) || [[ "$2" == --* ]]; then
          die "development_system.missing_option_value option=$option"
        fi
        if [[ "$option" == "--project" ]]; then
          project=$2
        elif [[ "$option" == "--preset" ]]; then
          preset=$2
        elif [[ "$option" == "--delivery" ]]; then
          # Delivery is now a semantic repository-remote policy. Keep parsing
          # this legacy flag only to provide a typed migration response.
          :
        elif [[ "$option" == "--enable" || "$option" == "--disable" ]]; then
          local selected=true
          if [[ "$option" == "--disable" ]]; then
            selected=false
          fi
          case "$2" in
            tiber) feature_tiber=$selected ;;
            agentic-systems) feature_agentic_systems=$selected ;;
            eval-case-reporting) feature_eval_case_reporting=$selected ;;
            *) die "development_system.unknown_feature feature=$2" ;;
          esac
        fi
        shift 2
        ;;
      --dry-run)
        mode=dry-run
        shift
        ;;
      --apply)
        mode=apply
        shift
        ;;
      --yes)
        :
        shift
        ;;
      *)
        die "development_system.unknown_option option=$1"
        ;;
    esac
  done
  require_primary_checkout "$project"
  project="$(cd "$project" && pwd)"
  if [[ "$preset" != "personal-trunk" ]]; then
    die "development_system.unsupported_preset preset=$preset"
  fi
  printf 'development_system.setup_preview project=%s\n' "$project"
  printf 'features tiber=%s agentic_systems=%s eval_case_reporting=%s\n' \
    "$feature_tiber" "$feature_agentic_systems" "$feature_eval_case_reporting"
  printf 'use setup.preview followed by setup.apply confirmed=true through development-discipline MCP\n'
  if [[ "$mode" == "dry-run" ]]; then
    return
  fi
  die "development_system.setup_mcp_required"
}

inspect_conflicts() {
  local project=$1
  local harness=$2

  if [[ ! -f "$project/.development-system.toml" ]]; then
    return
  fi

  case "$harness" in
    codex) inspect_codex_conflicts "$project" ;;
    pi) inspect_pi_conflicts "$project" ;;
  esac
}

# Pi treats `-` and `_` in MCP server names as the same server.
pi_owned_mcp_server() {
  case "${1//_/-}" in
    development-discipline | tiber) return 0 ;;
    *) return 1 ;;
  esac
}

inspect_pi_conflicts() {
  local project=$1
  local found=false
  local agent_dir=${PI_CODING_AGENT_DIR:-${HOME:-}/.pi/agent}
  local file server

  # A file-configured server takes precedence over the extension registration.
  for file in "$project/.pi/mcp.json" "$agent_dir/mcp.json"; do
    [[ -f "$file" ]] || continue
    if ! jq -e '(.mcpServers // {}) | type == "object"' "$file" >/dev/null 2>&1; then
      warn "unreadable_harness_config harness=pi file=$file"
      found=true
      continue
    fi
    while IFS= read -r server; do
      if pi_owned_mcp_server "$server"; then
        warn "mcp_server_override harness=pi server=$server file=$file recommendation=remove_entry_so_development-system_registers_it"
        found=true
      fi
    done < <(jq -r '(.mcpServers // {}) | keys[]' "$file")
  done

  # Without built-in MCP support, nothing connects registered servers.
  for file in "$project/.pi/settings.json" "$agent_dir/settings.json"; do
    [[ -f "$file" ]] || continue
    if ! jq -e 'type == "object"' "$file" >/dev/null 2>&1; then
      warn "unreadable_harness_config harness=pi file=$file"
      found=true
      continue
    fi
    if jq -e '(.extensions // []) | index("-builtin:mcp") != null' "$file" >/dev/null; then
      warn "incompatible_harness_setting harness=pi setting=builtin_mcp_disabled file=$file"
      found=true
    fi
  done

  if [[ "$found" == "true" ]]; then
    warn "supply_chain_recommendation harness=pi recommendation=let_development-system_register_its_mcps"
  fi
}

inspect_codex_conflicts() {
  local project=$1
  local found=false
  local codex_home=${CODEX_HOME:-${HOME:-}/.codex}
  local codex_config

  for codex_config in "$project/.codex/config.toml" "$codex_home/config.toml"; do
    if [[ -f "$codex_config" ]] &&
      grep -Ev '^\[plugins\."?development-system(@ai-plugins)?"?\]' "$codex_config" |
      grep -Eq '^\[plugins\.[^]]+\]'; then
      warn "conflicting_plugins harness=codex file=$codex_config recommendation=install_only_development-system"
      found=true
    fi

    if [[ -f "$codex_config" ]] &&
      grep -Eq '^[[:space:]]*(hooks|codex_hooks)[[:space:]]*=[[:space:]]*false' "$codex_config"; then
      warn "incompatible_harness_setting harness=codex setting=hooks_disabled file=$codex_config"
      found=true
    fi

    if [[ -f "$codex_config" ]] &&
      grep -Eq '^[[:space:]]*allow_managed_hooks_only[[:space:]]*=[[:space:]]*true' "$codex_config"; then
      warn "incompatible_harness_setting harness=codex setting=managed_hooks_only file=$codex_config"
      found=true
    fi
  done

  if [[ "$found" == "true" ]]; then
    warn "supply_chain_recommendation harness=codex recommendation=use_only_development-system_and_plugin_managed_mcps"
  fi
}

doctor_command() {
  local project=.
  local format=text
  local harness=codex
  while (($#)); do
    case "$1" in
      --project | --format | --harness)
        local option=$1
        if (($# < 2)) || [[ "$2" == --* ]]; then
          die "development_system.missing_option_value option=$option"
        fi
        if [[ "$option" == "--project" ]]; then
          project=$2
        elif [[ "$option" == "--harness" ]]; then
          case "$2" in
            codex | pi) harness=$2 ;;
            *) die "development_system.unsupported_harness harness=$2" ;;
          esac
        else
          format=$2
        fi
        shift 2
        ;;
      *)
        die "development_system.unknown_option option=$1"
        ;;
    esac
  done
  project="$(cd "$project" && pwd)" ||
    die "development_system.project_not_found project=$project"
  local output
  output="$(inspect_conflicts "$project" "$harness")"
  if [[ -z "$output" ]]; then
    return
  fi
  if [[ "$format" == "text" ]]; then
    printf '%s\n' "$output"
  elif [[ "$format" == "json" ]]; then
    output=${output//\\/\\\\}
    output=${output//\"/\\\"}
    output=${output//$'\n'/\\n}
    printf '{"continue":true,"systemMessage":"%s"}\n' "$output"
  else
    die "development_system.unsupported_format format=$format"
  fi
}

ensure_current_binaries() {
  if development_system_installation_matches_plugin "$plugin_root"; then
    return
  fi
  "$plugin_root/scripts/install-development-system-binaries.sh" --auto >/dev/null
  development_system_installation_matches_plugin "$plugin_root" ||
    die "development_system.binary_install_verification_failed"
}

case "${1:-}" in
  setup)
    shift
    setup_command "$@"
    ;;
  doctor)
    shift
    doctor_command "$@"
    ;;
  session-start)
    shift
    ensure_current_binaries
    doctor_command "$@"
    ;;
  *)
    die "development_system.usage command=${1:-missing}"
    ;;
esac
