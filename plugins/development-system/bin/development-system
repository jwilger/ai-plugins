#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_ROOT="$(dirname "$SCRIPT_DIR")"

die() {
  printf '%s\n' "$*" >&2
  exit 2
}

warn() {
  printf 'development_system.warning %s\n' "$*"
}

primary_checkout() {
  local project=$1
  local common_dir
  common_dir="$(git -C "$project" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ||
    die "development_system.not_a_git_repository project=$project"
  dirname "$common_dir"
}

require_primary_checkout() {
  local project=$1
  local git_dir common_dir primary
  if [[ "$(git -C "$project" rev-parse --is-bare-repository 2>/dev/null)" == "true" ]]; then
    die "development_system.setup_requires_checkout project=$project"
  fi
  git_dir="$(git -C "$project" rev-parse --path-format=absolute --git-dir 2>/dev/null)" ||
    die "development_system.not_a_git_repository project=$project"
  common_dir="$(git -C "$project" rev-parse --path-format=absolute --git-common-dir)"
  if [[ "$git_dir" != "$common_dir" ]]; then
    primary="$(primary_checkout "$project")"
    die "development_system.setup_requires_primary_checkout primary_checkout=$primary"
  fi
}

setup_command() {
  local project=.
  local preset=personal-trunk
  local delivery=direct-to-trunk
  local mode=dry-run
  local confirmed=false
  local feature_worktrees=true
  local feature_beads=true
  local feature_agentic_systems=false
  local feature_eval_case_reporting=false
  while (($#)); do
    case "$1" in
      --project | --preset | --delivery | --enable | --disable)
        local option=$1
        if (($# < 2)) || [[ "$2" == --* ]]; then
          die "development_system.missing_option_value option=$option"
        fi
        if [[ "$option" == "--project" ]]; then
          project=$2
        elif [[ "$option" == "--preset" ]]; then
          preset=$2
        elif [[ "$option" == "--delivery" ]]; then
          delivery=$2
        elif [[ "$option" == "--enable" || "$option" == "--disable" ]]; then
          local selected=true
          if [[ "$option" == "--disable" ]]; then
            selected=false
          fi
          case "$2" in
            worktrees) feature_worktrees=$selected ;;
            beads) feature_beads=$selected ;;
            agentic-systems) feature_agentic_systems=$selected ;;
            eval-case-reporting) feature_eval_case_reporting=$selected ;;
            *) die "development_system.unknown_feature feature=$2" ;;
          esac
        fi
        shift 2
        ;;
      --dry-run)
        mode=dry-run
        shift
        ;;
      --apply)
        mode=apply
        shift
        ;;
      --yes)
        confirmed=true
        shift
        ;;
      *)
        die "development_system.unknown_option option=$1"
        ;;
    esac
  done
  require_primary_checkout "$project"
  project="$(cd "$project" && pwd)"
  if [[ "$preset" != "personal-trunk" ]]; then
    die "development_system.unsupported_preset preset=$preset"
  fi
  case "$delivery" in
    direct-to-trunk | pull-request | local-only) ;;
    *) die "development_system.unsupported_delivery mode=$delivery" ;;
  esac
  printf 'development_system.setup_preview project=%s\n' "$project"
  printf 'delivery %s\n' "$delivery"
  printf 'features worktrees=%s beads=%s agentic_systems=%s eval_case_reporting=%s\n' \
    "$feature_worktrees" "$feature_beads" "$feature_agentic_systems" "$feature_eval_case_reporting"
  local tool_status_json=
  if [[ "$feature_beads" == "true" ]]; then
    tool_status_json="$(node "$PACKAGE_ROOT/bin/install-development-tool.mjs" status --json)" ||
      die "development_system.tool_status_failed"
    TOOL_STATUS_JSON="$tool_status_json" node - <<'NODE'
const policy = JSON.parse(process.env.TOOL_STATUS_JSON);
console.log("required user-global tools:");
for (const tool of policy.tools.filter((candidate) => candidate.requiredFor.includes("beads"))) {
  console.log(`${tool.name}: current=${tool.currentVersion ?? tool.status} status=${tool.status} target=${tool.targetVersion}`);
}
console.log(`destination: ${policy.destination}`);
console.log("scope: user-global for the current user across projects");
console.log("sudo: not required");
NODE
    printf 'install or update required tools only after this setup is approved; use Beads embedded Dolt storage; initialize Beads and install workflow formulas\n'
  fi
  printf 'write .development-system.toml\n'
  if [[ "$mode" == "dry-run" ]]; then
    return
  fi
  if [[ "$confirmed" != "true" ]]; then
    die "development_system.setup_requires_confirmation"
  fi
  if [[ -n "$(git -C "$project" status --porcelain=v1 --untracked-files=no)" ]]; then
    die "development_system.setup_tracked_changes_present"
  fi

  local config_path=$project/.development-system.toml
  local config_tmp
  local setup_head
  setup_head="$(git -C "$project" rev-parse HEAD)"
  local created_beads=false
  local -a added_beads_formulas=()
  if [[ -e "$config_path" || -L "$config_path" ]]; then
    die "development_system.config_already_exists path=$config_path"
  fi
  trap 'rm -f -- "${config_tmp:-}"; if [[ "${created_beads:-false}" == "true" ]]; then git -C "$project" reset -q HEAD -- .beads .gitignore 2>/dev/null || true; rm -rf -- "$project/.beads"; if git -C "$project" cat-file -e HEAD:.gitignore 2>/dev/null; then git -C "$project" checkout -q -- .gitignore; else rm -f -- "$project/.gitignore"; fi; elif ((${#added_beads_formulas[@]} > 0)); then rm -f -- "${added_beads_formulas[@]}"; fi' EXIT
  local tool_install_json=
  if [[ "$feature_beads" == "true" ]]; then
    local bd_bin
    local -a required_tools=()
    while IFS= read -r tool; do
      [[ -n "$tool" ]] && required_tools+=("$tool")
    done < <(TOOL_STATUS_JSON="$tool_status_json" node -e '
      const policy = JSON.parse(process.env.TOOL_STATUS_JSON);
      for (const tool of policy.tools.filter((candidate) => candidate.requiredFor.includes("beads"))) console.log(tool.name);
    ')
    ((${#required_tools[@]} > 0)) || die "development_system.required_tools_missing feature=beads"
    tool_install_json="$(node "$PACKAGE_ROOT/bin/install-development-tool.mjs" install --json "${required_tools[@]}")" ||
      die "development_system.beads_install_failed"
    bd_bin="$(TOOL_INSTALL_JSON="$tool_install_json" node -e '
      const policy = JSON.parse(process.env.TOOL_INSTALL_JSON);
      const bd = policy.tools.find((tool) => tool.name === "bd");
      if (!bd?.executable || bd.status !== "compatible") process.exit(2);
      process.stdout.write(bd.executable);
    ')" || die "development_system.beads_install_failed"
    export PATH="$(dirname "$bd_bin"):$PATH"
    if [[ ! -d "$project/.beads" ]]; then
      (
        cd "$project"
        "$bd_bin" init --quiet --non-interactive --skip-agents --skip-hooks
      ) || die "development_system.beads_init_failed project=$project"
      created_beads=true
      local initialized_head
      initialized_head="$(git -C "$project" rev-parse HEAD)"
      if [[ "$initialized_head" != "$setup_head" ]]; then
        if [[ "$(git -C "$project" rev-parse "$initialized_head^")" != "$setup_head" ]]; then
          rm -rf -- "$project/.beads"
          die "development_system.beads_init_history_unexpected"
        fi
        git -C "$project" reset --soft "$setup_head"
      fi
    else
      (
        cd "$project"
        "$bd_bin" where >/dev/null
      ) || die "development_system.beads_workspace_invalid project=$project"
    fi
    mkdir -p "$project/.beads/formulas"
    local formula source_formula target_formula
    for source_formula in "$PACKAGE_ROOT"/formulas/*.formula.toml; do
      formula="$(basename "$source_formula")"
      target_formula="$project/.beads/formulas/$formula"
      if [[ -e "$target_formula" ]] && ! cmp -s "$source_formula" "$target_formula"; then
        if [[ "$created_beads" == "true" ]]; then rm -rf -- "$project/.beads"; fi
        die "development_system.beads_formula_conflict path=$target_formula"
      fi
      if [[ ! -e "$target_formula" ]]; then
        cp -- "$source_formula" "$target_formula"
        added_beads_formulas+=("$target_formula")
      fi
    done
    (
      cd "$project"
      "$bd_bin" config set dolt.auto-commit on >/dev/null
    ) || die "development_system.beads_config_failed project=$project"
  fi
  config_tmp="$(mktemp "$project/.development-system.toml.tmp.XXXXXX")" ||
    die "development_system.config_temp_failed project=$project"
  {
    printf 'schema_version = 2\n\n'
    printf '[delivery]\n'
    printf 'mode = "%s"\n' "$delivery"
    printf 'trunk_branch = "main"\n\n'
    printf '[features]\n'
    printf 'worktrees = %s\n' "$feature_worktrees"
    printf 'beads = %s\n' "$feature_beads"
    printf 'agentic_systems = %s\n' "$feature_agentic_systems"
    printf 'eval_case_reporting = %s\n\n' "$feature_eval_case_reporting"
    printf '[worktrees]\n'
    printf 'root = ".worktrees"\n\n'
    printf '[beads]\n'
    case "$delivery" in
      direct-to-trunk) printf 'workflow = "development-change-direct"\n' ;;
      pull-request) printf 'workflow = "development-change-pr"\n' ;;
      local-only) printf 'workflow = "development-change-local"\n' ;;
    esac
  } >"$config_tmp"
  mv -- "$config_tmp" "$config_path"
  git -C "$project" add -- .development-system.toml
  if [[ "$feature_beads" == "true" ]]; then
    git -C "$project" add -f -- .beads/.gitignore .beads/README.md .beads/config.yaml .beads/metadata.json .beads/formulas
  fi
  if ! git -C "$project" commit --no-verify \
    -m "chore: initialize development system" \
    -m "Record the project workflow and optional integrations in one authoritative configuration."; then
    git -C "$project" reset -q HEAD -- .development-system.toml .beads .gitignore 2>/dev/null || true
    rm -f -- "$config_path"
    if [[ "$created_beads" == "true" ]]; then
      rm -rf -- "$project/.beads"
      if git -C "$project" cat-file -e HEAD:.gitignore 2>/dev/null; then
        git -C "$project" checkout -q -- .gitignore
      else
        rm -f -- "$project/.gitignore"
      fi
    elif ((${#added_beads_formulas[@]} > 0)); then
      rm -f -- "${added_beads_formulas[@]}"
    fi
    die "development_system.setup_commit_failed"
  fi
  trap - EXIT
  printf 'development_system.setup_applied commit=%s\n' "$(git -C "$project" rev-parse HEAD)"
  if [[ -n "$tool_install_json" ]]; then
    TOOL_INSTALL_JSON="$tool_install_json" node - <<'NODE'
const policy = JSON.parse(process.env.TOOL_INSTALL_JSON);
const versions = policy.tools.map((tool) => `${tool.name}=${tool.targetVersion}`).join(" ");
if (policy.installed.length > 0) {
  console.log(`development_system.setup_tools_installed ${versions} destination=${policy.destination}`);
} else {
  console.log(`development_system.setup_tools_compatible ${versions}`);
}
if (policy.usesUserGlobal && !policy.inheritedPathIncludesDestination && policy.pathAction) {
  console.log(`development_system.user_global_bin_not_in_inherited_path action=${JSON.stringify(policy.pathAction)}`);
}
NODE
  fi
}

inspect_conflicts() {
  local project=$1
  local harness=$2
  local found=false
  local claude_settings=$project/.claude/settings.json
  local claude_plugins=${CLAUDE_CONFIG_DIR:-${HOME:-}/.claude}/plugins/installed_plugins.json
  local codex_home=${CODEX_HOME:-${HOME:-}/.codex}
  local codex_config

  if [[ ! -f "$project/.development-system.toml" ]]; then
    return
  fi

  if [[ "$harness" == "all" || "$harness" == "claude" ]]; then
    if [[ -f "$claude_settings" ]] &&
      grep -q '"enabledPlugins"' "$claude_settings" &&
      grep -Eo '"[^"]+@[^"]+"[[:space:]]*:[[:space:]]*true' "$claude_settings" |
      grep -qv '^"development-system@'; then
      warn "conflicting_plugins harness=claude file=$claude_settings recommendation=install_only_development-system"
      found=true
    fi

    if [[ -f "$claude_plugins" ]] &&
      grep -Eo '"[^"]+@[^"]+"' "$claude_plugins" |
      grep -qv '^"development-system@'; then
      warn "conflicting_plugins harness=claude file=$claude_plugins recommendation=install_only_development-system"
      found=true
    fi

    if [[ -f "$project/.mcp.json" ]]; then
      warn "user_managed_mcps_detected harness=claude file=$project/.mcp.json action=review_for_compatibility"
      found=true
    fi
  fi

  if [[ "$harness" == "all" || "$harness" == "codex" ]]; then
    for codex_config in "$project/.codex/config.toml" "$codex_home/config.toml"; do
      if [[ -f "$codex_config" ]] &&
        grep -Ev '^\[plugins\."?development-system(@ai-plugins)?"?\]' "$codex_config" |
        grep -Eq '^\[plugins\.[^]]+\]'; then
        warn "conflicting_plugins harness=codex file=$codex_config recommendation=install_only_development-system"
        found=true
      fi

      if [[ -f "$codex_config" ]] &&
        grep -Eq '^[[:space:]]*(hooks|codex_hooks)[[:space:]]*=[[:space:]]*false' "$codex_config"; then
        warn "incompatible_harness_setting harness=codex setting=hooks_disabled file=$codex_config"
        found=true
      fi

      if [[ -f "$codex_config" ]] &&
        grep -Eq '^[[:space:]]*allow_managed_hooks_only[[:space:]]*=[[:space:]]*true' "$codex_config"; then
        warn "incompatible_harness_setting harness=codex setting=managed_hooks_only file=$codex_config"
        found=true
      fi
    done
  fi

  if [[ "$found" == "true" ]]; then
    warn "supply_chain_recommendation harness=$harness recommendation=use_only_development-system_and_plugin_managed_mcps"
  fi
}

doctor_command() {
  local project=.
  local harness=all
  local format=text
  while (($#)); do
    case "$1" in
      --project | --harness | --format)
        local option=$1
        if (($# < 2)) || [[ "$2" == --* ]]; then
          die "development_system.missing_option_value option=$option"
        fi
        if [[ "$option" == "--project" ]]; then
          project=$2
        elif [[ "$option" == "--harness" ]]; then
          harness=$2
        else
          format=$2
        fi
        shift 2
        ;;
      *)
        die "development_system.unknown_option option=$1"
        ;;
    esac
  done
  case "$harness" in
    all | claude | codex | pi) ;;
    *) die "development_system.unsupported_harness harness=$harness" ;;
  esac
  project="$(cd "$project" && pwd)" ||
    die "development_system.project_not_found project=$project"
  local output
  output="$(inspect_conflicts "$project" "$harness")"
  if [[ -z "$output" ]]; then
    return
  fi
  if [[ "$format" == "text" ]]; then
    printf '%s\n' "$output"
  elif [[ "$format" == "json" ]]; then
    output=${output//\\/\\\\}
    output=${output//\"/\\\"}
    output=${output//$'\n'/\\n}
    printf '{"continue":true,"systemMessage":"%s"}\n' "$output"
  else
    die "development_system.unsupported_format format=$format"
  fi
}

record_eval_session_start() {
  if [[ -n "${DEVELOPMENT_SYSTEM_EVAL_SESSION_START_MARKER:-}" ]]; then
    if [[ "$DEVELOPMENT_SYSTEM_EVAL_SESSION_START_MARKER" != /* ]]; then
      die "development_system.eval_marker_requires_absolute_path"
    fi
    umask 077
    : >"$DEVELOPMENT_SYSTEM_EVAL_SESSION_START_MARKER"
  fi
}

case "${1:-}" in
  setup)
    shift
    setup_command "$@"
    ;;
  doctor)
    shift
    doctor_command "$@"
    ;;
  session-start)
    shift
    record_eval_session_start
    doctor_command "$@"
    ;;
  migrate-tiber-to-beads)
    shift
    exec node "$SCRIPT_DIR/migrate-tiber-to-beads.mjs" "$@"
    ;;
  *)
    die "development_system.usage command=${1:-missing}"
    ;;
esac
