#!/usr/bin/env bash
set -euo pipefail

die() {
  printf '%s\n' "$*" >&2
  exit 2
}

primary_checkout() {
  local project=$1
  local common_dir
  common_dir="$(git -C "$project" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ||
    die "development_system.not_a_git_repository project=$project"
  dirname "$common_dir"
}

require_primary_checkout() {
  local project=$1
  local git_dir common_dir primary
  if [[ "$(git -C "$project" rev-parse --is-bare-repository 2>/dev/null)" == "true" ]]; then
    die "development_system.setup_requires_checkout project=$project"
  fi
  git_dir="$(git -C "$project" rev-parse --path-format=absolute --git-dir 2>/dev/null)" ||
    die "development_system.not_a_git_repository project=$project"
  common_dir="$(git -C "$project" rev-parse --path-format=absolute --git-common-dir)"
  if [[ "$git_dir" != "$common_dir" ]]; then
    primary="$(primary_checkout "$project")"
    die "development_system.setup_requires_primary_checkout primary_checkout=$primary"
  fi
}

setup_command() {
  local project=.
  local preset=personal-trunk
  local mode=dry-run
  local confirmed=false
  while (($#)); do
    case "$1" in
      --project | --preset | --delivery)
        local option=$1
        if (($# < 2)) || [[ "$2" == --* ]]; then
          die "development_system.missing_option_value option=$option"
        fi
        if [[ "$option" == "--project" ]]; then
          project=$2
        elif [[ "$option" == "--preset" ]]; then
          preset=$2
        fi
        shift 2
        ;;
      --dry-run)
        mode=dry-run
        shift
        ;;
      --apply)
        mode=apply
        shift
        ;;
      --yes)
        confirmed=true
        shift
        ;;
      *)
        die "development_system.unknown_option option=$1"
        ;;
    esac
  done
  require_primary_checkout "$project"
  project="$(cd "$project" && pwd)"
  if [[ "$preset" != "personal-trunk" ]]; then
    die "development_system.unsupported_preset preset=$preset"
  fi
  printf 'development_system.setup_preview project=%s\n' "$project"
  printf 'write .development-system.toml\n'
  if [[ "$mode" == "dry-run" ]]; then
    return
  fi
  if [[ "$confirmed" != "true" ]]; then
    die "development_system.setup_requires_confirmation"
  fi
  if [[ -n "$(git -C "$project" status --porcelain=v1 --untracked-files=no)" ]]; then
    die "development_system.setup_tracked_changes_present"
  fi

  local config_path=$project/.development-system.toml
  local config_tmp
  if [[ -e "$config_path" || -L "$config_path" ]]; then
    die "development_system.config_already_exists path=$config_path"
  fi
  config_tmp="$(mktemp "$project/.development-system.toml.tmp.XXXXXX")" ||
    die "development_system.config_temp_failed project=$project"
  trap 'rm -f -- "$config_tmp"' EXIT
  {
    printf 'schema_version = 1\n\n'
    printf '[delivery]\n'
    printf 'mode = "direct-to-trunk"\n'
    printf 'trunk_branch = "main"\n\n'
    printf '[features]\n'
    printf 'worktrees = true\n'
    printf 'tiber = true\n'
    printf 'agentic_systems = false\n'
    printf 'eval_case_reporting = false\n\n'
    printf '[worktrees]\n'
    printf 'root = ".worktrees"\n\n'
    printf '[tiber]\n'
    printf 'max_queued = 5\n\n'
    printf '[mcps]\n'
    printf 'context7 = false\n'
    printf 'hindsight = false\n'
    printf 'openai_developer_docs = false\n'
    printf 'promptfoo = false\n'
  } >"$config_tmp"
  mv -- "$config_tmp" "$config_path"
  git -C "$project" add -- .development-system.toml
  if ! git -C "$project" commit \
    -m "chore: initialize development system" \
    -m "Record the project workflow and optional integrations in one authoritative configuration."; then
    git -C "$project" reset -q HEAD -- .development-system.toml
    rm -f -- "$config_path"
    die "development_system.setup_commit_failed"
  fi
  trap - EXIT
  printf 'development_system.setup_applied commit=%s\n' "$(git -C "$project" rev-parse HEAD)"
}

case "${1:-}" in
  setup)
    shift
    setup_command "$@"
    ;;
  *)
    die "development_system.usage command=${1:-missing}"
    ;;
esac
