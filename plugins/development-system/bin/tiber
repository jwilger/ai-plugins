#!/bin/sh
set -eu

plugin_root="$(cd -- "$(dirname -- "$0")/.." && pwd -P)"
config_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$config_root" ] && [ -f "$config_root/.development-system.toml" ]; then
  tiber_enabled="$(
    awk '
      /^\[features\][[:space:]]*$/ { in_features = 1; next }
      /^\[/ { in_features = 0 }
      in_features && /^[[:space:]]*tiber[[:space:]]*=/ {
        sub(/^[^=]*=[[:space:]]*/, "")
        sub(/[[:space:]#].*$/, "")
        print
        exit
      }
    ' "$config_root/.development-system.toml"
  )"
  if [ "$tiber_enabled" = "false" ]; then
    echo "development_system.feature_disabled feature=tiber config=$config_root/.development-system.toml" >&2
    exit 2
  fi
fi
if [ "${DEVELOPMENT_SYSTEM_TIBER_FORWARDING:-}" != 1 ] && command -v tiber >/dev/null 2>&1; then
  companion="$(command -v tiber)"
  if [ "$(realpath "$companion")" != "$(realpath "$0")" ]; then
    export DEVELOPMENT_SYSTEM_TIBER_FORWARDING=1
    exec "$companion" "$@"
  fi
fi
echo "development_system.tiber_companion_missing remediation='install tiber@ai-plugins; use the Tiber plugin launcher and preview tiber install-bin --target-dir ~/.local/bin --dry-run'" >&2
exit 2
