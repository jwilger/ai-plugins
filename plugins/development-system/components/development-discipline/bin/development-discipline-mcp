#!/usr/bin/env bash
set -euo pipefail

script_dir="${BASH_SOURCE[0]%/*}"
plugin_root="$(cd -- "$script_dir/.." && pwd -P)"
development_system_root="$(cd -- "$plugin_root/../.." && pwd -P)"
export DEVELOPMENT_SYSTEM_DISCIPLINE_LAUNCHER="${DEVELOPMENT_SYSTEM_DISCIPLINE_LAUNCHER:-$plugin_root/bin/development-discipline-mcp}"
source "$development_system_root/lib/installed-binary.sh"
development_system_exec_installed_binary "$development_system_root" development-discipline-mcp "$@"
