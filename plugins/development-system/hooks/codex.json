{
  "description": "Warn about conflicting development plugins, harness settings, and user-managed MCPs.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/development-system\" session-start --project \"$PWD\" --harness codex --format json",
            "timeout": 10,
            "statusMessage": "Checking development system compatibility"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/development-discipline-mcp\" --hook codex-pre-tool-use",
            "timeout": 10,
            "statusMessage": "Enforcing Development System agent capabilities"
          }
        ]
      }
    ]
  }
}
