{
  "name": "ai-plugins",
  "version": "1.14.0",
  "private": true,
  "description": "Git-installable Pi facade for the development-system multi-harness marketplace.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwilger/ai-plugins.git"
  },
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "pi-package",
    "development",
    "workflow",
    "worktrees",
    "beads",
    "quality"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "bin": {
    "bd": "./plugins/development-system/bin/bd",
    "dolt": "./plugins/development-system/bin/dolt",
    "development-system": "./plugins/development-system/bin/development-system"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "piCompatibility": ">=0.82.0 <0.83.0",
  "pi": {
    "extensions": [
      "./plugins/development-system/extensions/development-system/index.ts"
    ],
    "skills": [
      "./plugins/development-system/skills/agentic-systems",
      "./plugins/development-system/skills/beads",
      "./plugins/development-system/skills/delivery",
      "./plugins/development-system/skills/development-workflow",
      "./plugins/development-system/skills/engineering-standards",
      "./plugins/development-system/skills/eval-case-reporting",
      "./plugins/development-system/skills/setup",
      "./plugins/development-system/skills/worktrees"
    ]
  }
}
